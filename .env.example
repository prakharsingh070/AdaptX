# ADAPT-X environment configuration example.
# Copy to .env and adjust. .env is git-ignored and must never contain
# committed secrets.
#
# Nested settings use a double underscore: ADAPTX_<SECTION>__<FIELD>.

# --- Application -----------------------------------------------------------
ADAPTX_APP__NAME=ADAPT-X
ADAPTX_APP__ENVIRONMENT=development          # development | staging | production
ADAPTX_APP__DEBUG=true

# --- API -------------------------------------------------------------------
ADAPTX_API__HOST=0.0.0.0
ADAPTX_API__PORT=8000
ADAPTX_API__RELOAD=true
ADAPTX_API__ROOT_PATH=                        # set when served behind a path prefix
ADAPTX_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Logging ---------------------------------------------------------------
ADAPTX_LOGGING__LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
ADAPTX_LOGGING__JSON_FORMAT=false                   # true = structured JSON lines

# --- CARLA -----------------------------------------------------------------
# CARLA is optional. With ENABLED=false the backend reports CARLA: DISCONNECTED
# and never attempts a connection.
ADAPTX_CARLA__ENABLED=false
ADAPTX_CARLA__HOST=localhost
ADAPTX_CARLA__PORT=2000
ADAPTX_CARLA__TIMEOUT_S=10.0
ADAPTX_CARLA__USE_MOCK=false                 # true = in-process fake simulator (development only)

# --- LiDAR input -----------------------------------------------------------
ADAPTX_LIDAR__MIN_POINTS=1
ADAPTX_LIDAR__MAX_POINTS=500000
ADAPTX_LIDAR__FRAME_STALE_AFTER_S=2.0
ADAPTX_LIDAR__METRICS_WINDOW=30              # frames in the FPS/latency measurement window

# Phase 2A preprocessing. Coordinate convention (ADR-009): +x forward,
# +y left, +z up, metres, origin at the sensor. All bounds are inclusive.
# These defaults are plausible starting values, not tuned or measured ones.
ADAPTX_LIDAR__MIN_RANGE_M=0.5                # sensor blind zone / ego returns
ADAPTX_LIDAR__MAX_RANGE_M=100.0
ADAPTX_LIDAR__ROI_X_MIN_M=-50.0              # behind the sensor
ADAPTX_LIDAR__ROI_X_MAX_M=80.0               # ahead of the sensor
ADAPTX_LIDAR__ROI_Y_MIN_M=-40.0              # right of the sensor
ADAPTX_LIDAR__ROI_Y_MAX_M=40.0               # left of the sensor
ADAPTX_LIDAR__ROI_Z_MIN_M=-3.0               # below the sensor
ADAPTX_LIDAR__ROI_Z_MAX_M=5.0                # above the sensor

# Phase 2B stages. All three are opt-in (ADR-012): they change what every
# downstream consumer sees, so none is enabled by default.
ADAPTX_LIDAR__VOXEL_ENABLED=false
ADAPTX_LIDAR__VOXEL_SIZE_M=0.10              # 0.05 / 0.10 / 0.20 / 0.50 are typical
ADAPTX_LIDAR__GROUND_ENABLED=false
ADAPTX_LIDAR__GROUND_CELL_SIZE_M=1.0         # xy cell used to find the local ground level
ADAPTX_LIDAR__GROUND_HEIGHT_TOLERANCE_M=0.20 # height above the cell minimum still counted as ground
# ADAPTX_LIDAR__GROUND_MAX_HEIGHT_M=         # optional ceiling; assumes a known level mount
ADAPTX_LIDAR__NOISE_ENABLED=false
ADAPTX_LIDAR__NOISE_CELL_SIZE_M=0.5          # neighbours counted over the 3x3x3 block of cells
ADAPTX_LIDAR__NOISE_MIN_NEIGHBORS=4

# --- Trajectory prediction (Phase 5) ---------------------------------------
# Deterministic constant-velocity baseline. These are engineering defaults,
# NOT measured real-world limits, and none is tuned against labelled data
# because no labelled trajectories exist.
ADAPTX_PREDICTION__HORIZON_S=3.0             # how far ahead a trajectory extends
ADAPTX_PREDICTION__INTERVAL_S=0.25           # spacing; points run t+0..horizon inclusive (13)
ADAPTX_PREDICTION__MAX_TRACKS=256            # tracks beyond this are recorded as skipped
ADAPTX_PREDICTION__MAX_SPEED_MPS=80.0        # faster tracks are rejected, never clipped
# Heuristic uncertainty: base + growth * extrapolation_seconds (ADR-026).
# Not a calibrated sigma, not a probability, not a confidence interval.
ADAPTX_PREDICTION__BASE_UNCERTAINTY_M=0.5    # radius at t+0; must be > 0
ADAPTX_PREDICTION__UNCERTAINTY_GROWTH_MPS=0.5
ADAPTX_PREDICTION__CONFIDENCE_HITS_FULL=3    # hits at which a track gives full evidence

# --- 2.5D map (Phase 6) ----------------------------------------------------
# Resolution *levels* are a vocabulary for a future resolution controller.
# No controller exists, so they describe what each level would mean, not a
# decision that has been made.
ADAPTX_MAP__RANGE_M=60.0                     # advertised range, reported by /map/status
ADAPTX_MAP__RESOLUTION_LOW_M=1.0
ADAPTX_MAP__RESOLUTION_MEDIUM_M=0.5
ADAPTX_MAP__RESOLUTION_HIGH_M=0.2
ADAPTX_MAP__RESOLUTION_CRITICAL_M=0.1

# What the fixed-resolution mapper actually uses. One cell size everywhere:
# adaptive allocation is NOT implemented (ADR-029). Baseline values, not tuned.
ADAPTX_MAP__RESOLUTION_M=0.5                 # cell edge length applied uniformly
ADAPTX_MAP__MIN_RESOLUTION_M=0.05            # finest a request may ask for
ADAPTX_MAP__MAX_RESOLUTION_M=5.0             # coarsest a request may ask for
# Mapped extent (ADR-009): +x forward, +y left. A point on a max edge is
# out of bounds, half-open cells (ADR-028).
ADAPTX_MAP__MIN_X_M=-60.0
ADAPTX_MAP__MAX_X_M=60.0
ADAPTX_MAP__MIN_Y_M=-60.0
ADAPTX_MAP__MAX_Y_M=60.0
# Memory guard, checked before any array is allocated. 4M cells is ~128 MB
# across the four dense arrays.
ADAPTX_MAP__MAX_CELLS=4000000

# --- Risk and uncertainty (Phase 7) ----------------------------------------
# Deterministic heuristic baseline. The score is NOT a probability of collision,
# is not calibrated, and has never been validated against labelled risk data -
# none exists. Every value below is a BASELINE ENGINEERING VALUE, not a
# safety-certified limit (ADR-032).
ADAPTX_RISK__MAX_RANGE_M=60.0                # used by the proximity-only baseline engine
# Score bands. UNKNOWN has no threshold: it means nothing was scored.
ADAPTX_RISK__THRESHOLD_MEDIUM=0.35
ADAPTX_RISK__THRESHOLD_HIGH=0.6
ADAPTX_RISK__THRESHOLD_CRITICAL=0.85

# Factor 1 - proximity: 1.0 at or inside NEAR, 0.0 at or beyond FAR, linear between.
ADAPTX_RISK__PROXIMITY_NEAR_M=5.0
ADAPTX_RISK__PROXIMITY_FAR_M=40.0
# Factor 2 - rate of approach. Receding objects contribute 0.0. Null velocity
# means unknown, so the factor is DROPPED rather than scored zero (ADR-023).
ADAPTX_RISK__CLOSING_SPEED_HIGH_MPS=15.0
# Factor 3 - how close the Phase 5 predicted path passes the ego reference.
ADAPTX_RISK__PREDICTED_PROXIMITY_NEAR_M=5.0

# Weighted mean over the factors actually available; a missing factor is dropped
# and the remaining weights renormalise.
ADAPTX_RISK__WEIGHT_PROXIMITY=0.5
ADAPTX_RISK__WEIGHT_CLOSING_SPEED=0.25
ADAPTX_RISK__WEIGHT_PREDICTED_PROXIMITY=0.25

# Uncertainty inputs. Uncertainty is reported SEPARATELY from risk, never folded
# into the score (ADR-033).
ADAPTX_RISK__STALE_OBSERVATION_S=0.5         # older observations raise uncertainty
ADAPTX_RISK__LOW_TRACK_CONFIDENCE=0.5        # Phase 3 geometric fit score, not a probability

ADAPTX_RISK__MAX_ASSESSED_TRACKS=512         # bounds response size

# --- WebSocket -------------------------------------------------------------
ADAPTX_WEBSOCKET__TELEMETRY_INTERVAL_S=1.0
ADAPTX_WEBSOCKET__MAX_CONNECTIONS=32
