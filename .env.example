# ADAPT-X environment configuration example.
# Copy to .env and adjust. .env is git-ignored and must never contain
# committed secrets.
#
# Nested settings use a double underscore: ADAPTX_<SECTION>__<FIELD>.

# --- Application -----------------------------------------------------------
ADAPTX_APP__NAME=ADAPT-X
ADAPTX_APP__ENVIRONMENT=development          # development | staging | production
ADAPTX_APP__DEBUG=true

# --- API -------------------------------------------------------------------
ADAPTX_API__HOST=0.0.0.0
ADAPTX_API__PORT=8000
ADAPTX_API__RELOAD=true
ADAPTX_API__ROOT_PATH=                        # set when served behind a path prefix
ADAPTX_API__CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Logging ---------------------------------------------------------------
ADAPTX_LOGGING__LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
ADAPTX_LOGGING__JSON_FORMAT=false                   # true = structured JSON lines

# --- CARLA -----------------------------------------------------------------
# CARLA is optional. With ENABLED=false the backend reports CARLA: DISCONNECTED
# and never attempts a connection.
ADAPTX_CARLA__ENABLED=false
ADAPTX_CARLA__HOST=localhost
ADAPTX_CARLA__PORT=2000
ADAPTX_CARLA__TIMEOUT_S=10.0
ADAPTX_CARLA__USE_MOCK=false                 # true = in-process fake simulator (development only)

# --- LiDAR input -----------------------------------------------------------
ADAPTX_LIDAR__MIN_POINTS=1
ADAPTX_LIDAR__MAX_POINTS=500000
ADAPTX_LIDAR__FRAME_STALE_AFTER_S=2.0
ADAPTX_LIDAR__METRICS_WINDOW=30              # frames in the FPS/latency measurement window

# --- 2.5D map --------------------------------------------------------------
ADAPTX_MAP__RANGE_M=60.0
ADAPTX_MAP__RESOLUTION_LOW_M=1.0
ADAPTX_MAP__RESOLUTION_MEDIUM_M=0.5
ADAPTX_MAP__RESOLUTION_HIGH_M=0.2
ADAPTX_MAP__RESOLUTION_CRITICAL_M=0.1

# --- Risk ------------------------------------------------------------------
ADAPTX_RISK__MAX_RANGE_M=60.0
ADAPTX_RISK__THRESHOLD_MEDIUM=0.35
ADAPTX_RISK__THRESHOLD_HIGH=0.6
ADAPTX_RISK__THRESHOLD_CRITICAL=0.85

# --- WebSocket -------------------------------------------------------------
ADAPTX_WEBSOCKET__TELEMETRY_INTERVAL_S=1.0
ADAPTX_WEBSOCKET__MAX_CONNECTIONS=32
